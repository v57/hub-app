<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.developer.networking.networkextension</key>
	<array>
		<string>packet-tunnel-provider</string>
	</array>
	<key>com.apple.developer.sensitivecontentanalysis.client</key>
	<array>
		<string>analysis</string>
	</array>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.dev.v57.hub</string>
		<string>group.dev.v57</string>
	</array>
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)dev.v57.Hub</string>
		<string>$(AppIdentifierPrefix)dev.v57.records</string>
		<string>$(AppIdentifierPrefix)dev.v57.device</string>
	</array>
	<!-- The v57 vault (v57/Vault): the hubs, devices and hosts every v57 app shares, in the app group container, a copy of the vault keys
	     in the records group, the Hub device key in the device group (no passwords or other keys: Hub decision 11), and iCloud sync through CloudKit. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.dev.v57</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.icloud-container-environment</key>
	<string>Production</string>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
